<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:layoutDirection="rtl">

    <!-- Top Header: Receivables & Collection Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_receivables_title"
                android:textColor="@color/widget_text_subtitle"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_total_receivables"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_zero_amount"
                android:textColor="@color/widget_text_title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Button "تحصيل" -->
        <TextView
            android:id="@+id/btn_collection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_button_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/widget_collect_button"
            android:textColor="@color/widget_btn_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- Divider: FrameLayout because plain <View> is not allowed inside app widgets -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/widget_border" />

    <!-- Bottom Row: Collected Today & Due Today -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Collected Today -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_stat_bg"
            android:padding="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_collected_today_title"
                android:textColor="@color/widget_text_subtitle"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_collected_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_zero_amount"
                android:textColor="@color/widget_green"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Due Customers Today -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_stat_bg"
            android:padding="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_due_title"
                android:textColor="@color/widget_text_subtitle"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_due_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_no_customers"
                android:textColor="@color/widget_amber"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Last update time (or a hint to open the app when the data is from a previous day) -->
    <TextView
        android:id="@+id/widget_last_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="start"
        android:text="@string/widget_open_to_update"
        android:textColor="@color/widget_text_subtitle"
        android:textSize="10sp"
        android:maxLines="1" />
</LinearLayout>

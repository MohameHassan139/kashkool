{
  "name": "kashkool-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kashkool backend API (Node.js + MongoDB, deployed on Vercel)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "node --env-file=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mingo": "^6.5.1",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.3.2"
  }
}
